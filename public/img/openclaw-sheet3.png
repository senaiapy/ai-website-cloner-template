<body class="member-body">
<div class="glowtop"></div>

<!-- carregando ate confirmar sessao -->
<div id="loader" class="page-loader"><div class="spinner" aria-label="Carregando"></div></div>

<div id="app" class="app" hidden>

  <!-- topbar mobile -->
  <div class="topbar">
    <button class="hamburger" id="menuBtn" aria-label="Abrir menu" aria-expanded="false">
      <span></span>
    </button>
    <a class="wordmark wordmark-nucleo" href="/"><span class="wm-main">Núcleo <em>Avalanche</em></span><span class="wm-sub">Estudos avançados em IA Agêntica</span></a>
  </div>

  <div class="scrim" id="scrim"></div>

  <!-- sidebar -->
  <aside class="sidebar" id="sidebar">
    <div class="sidebar-top">
      <span class="kicker">Denderson.ai</span>
      <a class="wordmark wordmark-nucleo" href="/"><span class="wm-main">Núcleo <em>Avalanche</em></span><span class="wm-sub">Estudos avançados em IA Agêntica</span></a>
    </div>
    <nav class="nav" id="nav" aria-label="Aulas"></nav>
    <div class="sidebar-foot">
      <div class="user-row">
        <div class="avatar" id="avatar">N</div>
        <div class="user-meta">
          <div class="founder-badge" id="founderBadge" hidden><span class="founder-star" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3.6l2.6 5.3 5.8.8-4.2 4.1 1 5.8-5.2-2.7-5.2 2.7 1-5.8L3.6 9.7l5.8-.8z"/></svg></span> Membro Fundador</div>
