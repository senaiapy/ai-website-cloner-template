          <div class="email" id="userEmail"></div>
        </div>
      </div>
      <button class="theme-toggle" id="themeToggle" type="button" aria-label="Alternar tema">
        <span class="theme-toggle-ic" id="themeToggleIc" aria-hidden="true"></span>
        <span class="theme-toggle-label" id="themeToggleLabel">Tema escuro</span>
      </button>
      <div class="foot-actions">
        <a class="btn-ghost" id="adminLink" href="/admin.html" hidden>Painel admin</a>
        <button class="btn-ghost" id="logoutBtn" type="button">Sair</button>
